# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 원본 사진 (각 10MB대). 리사이즈본만 public/images/ 에 커밋한다.
# 재리사이즈에 필요하므로 로컬에서는 삭제하지 말 것 (scripts/resize-images.js 로 재생성)
/_source-images/

# 작업용 임시 파일
/tmp/
